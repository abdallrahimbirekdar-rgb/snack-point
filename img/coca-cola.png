      var visibleMs = 0;
      var lastTick = Date.now();
      var scrolled = window.scrollY >= 80 ? 1 : 0;
      var interacted = 0;
      function addVisibleTime(){var now=Date.now();if(!document.hidden) visibleMs+=now-lastTick;lastTick=now;}
      function sendAutoView(){
        if (window.__cleanpngGaViewTracked || window.__cleanpngDedicatedViewBeacon) return;
